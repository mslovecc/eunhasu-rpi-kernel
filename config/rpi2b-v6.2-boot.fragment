# Raspberry Pi 2B early root-mount requirements for V6.2.
# Keep root-storage, partition-table and root-filesystem support built-in.
# Do not change the Diretta ABI settings in diretta-rpi2.fragment.

CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The Eunhasu boot command line uses PARTUUID, which requires partition parsing.
CONFIG_MSDOS_PARTITION=y

# V6.1 final config already selected ext4; make the rootfs dependency explicit.
CONFIG_EXT4_FS=y

# SD card block layer and both Pi 2B SD host controllers must be built-in.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
