# Orange Pi PC / Allwinner H3 board configuration.
# This fragment is merged on top of Linux 6.2.15 upstream sunxi_defconfig.
# Do not use the Fedora ARMv7 generic config as the configuration baseline.

CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I=y
CONFIG_CPU_V7=y
CONFIG_AEABI=y
CONFIG_SMP=y

# Orange Pi PC uses the H3 Allwinner UART for serial console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# SD/MMC boot and ext4 root filesystem must be available before root mount.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
CONFIG_EXT4_FS=y

# Runtime device management and initramfs support.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y

# Keep loop and squashfs available as modules for the existing rootfs/userspace.
CONFIG_BLK_DEV_LOOP=m
CONFIG_SQUASHFS=m

# Orange Pi PC onboard Ethernet: H3 GMAC + external PHY.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_ICPLUS_PHY=y

# USB host ports and USB storage support.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_STORAGE=m

# H3 pin control, system controller and board regulator.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN8I_H3=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_SY8106A=m
CONFIG_MFD_SYSCON=y

# H3 onboard audio path. Keep SoC audio drivers modular.
CONFIG_SND_SOC=m
CONFIG_SND_SUN4I_CODEC=m
CONFIG_SND_SUN4I_I2S=m
CONFIG_SND_SUN4I_SPDIF=m

# Preserve the original binary Diretta module loading model.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODVERSIONS is not set
