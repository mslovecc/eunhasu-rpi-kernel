# V8: Preserve Fedora 6.2.15-100 Raspberry Pi 2 hardware configuration,
# then apply only the original Eunhasu/Diretta ABI and SD-root requirements.
#
# Hardware baseline is extracted from the actual Fedora kernel-devel-6.2.15-100 RPM.
# Do not replace this with bcm2709_defconfig.

CONFIG_LOCALVERSION="-215.fc36.armv7hl"
# CONFIG_LOCALVERSION_AUTO is not set

# Match the original Diretta module vermagic.
CONFIG_SMP=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_RT is not set

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set

# Original A20/Eunhasu ABI requirements.
CONFIG_HIGHMEM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Pi 2 boots directly from its SD card without the mismatched legacy initramfs.
# All root-storage and root-filesystem components must therefore be built-in.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Keep Fedora's USB/DWC2/SMSC95XX and USB-audio selections unless Kconfig
# dependency resolution requires a change. Do not force them in this fragment.
