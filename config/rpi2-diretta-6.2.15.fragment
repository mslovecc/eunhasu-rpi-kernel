# Raspberry Pi 2 Model B + Diretta overlay for upstream Linux 6.2.15
# Target source:
#   torvalds/linux
#   commit 3c6c5ba197a9daf02c77ae39d65677c5e63e0845
#
# Intended base:
#   arch/arm/configs/multi_v7_defconfig
#
# This is a config fragment, not a standalone .config. Apply it to the
# version-pinned upstream 6.2.15 tree, then run:
#   make ARCH=arm olddefconfig
#
# Keep the original A20 module ABI-sensitive settings where they are
# meaningful on BCM2836. Same vermagic does NOT prove binary ABI compatibility.

# ---------------------------------------------------------------------------
# ARMv7 / module ABI baseline
# ---------------------------------------------------------------------------
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_BCM2835=y
CONFIG_CPU_V7=y
CONFIG_AEABI=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_RT is not set
# CONFIG_THUMB2_KERNEL is not set
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set

# Match the original module release string when building the kernel.
CONFIG_LOCALVERSION="-215.fc36.armv7hl"
# CONFIG_LOCALVERSION_AUTO is not set

# Preserve the ARM highmem page-address implementation used by the
# original alsa_bridge module. Kconfig may constrain this by memory layout.
CONFIG_HIGHMEM=y

# Keep usercopy / fortify support available; these options do not by
# themselves guarantee semantic ABI compatibility.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Do not reject unsigned out-of-tree modules at load time.
# Module signing may remain enabled, but force-signature enforcement must not.
# CONFIG_MODULE_SIG_FORCE is not set

# ---------------------------------------------------------------------------
# Audio: preserve USB vendor soundcards and Raspberry Pi I2S support.
# Do not disable generic ALSA, PCM, USB audio, or ASoC infrastructure.
# ---------------------------------------------------------------------------
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_BCM2835_SOC_I2S=m

# ---------------------------------------------------------------------------
# Raspberry Pi 2B connectivity and root-storage essentials.
# These are intentionally retained even when unrelated drivers are pruned.
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_MMC=y
CONFIG_MMC_BLOCK=m
CONFIG_MMC_BCM2835=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_BCM2835AUX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_BCM2835_WDT=y
CONFIG_DMA_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_DRM_VC4=m
CONFIG_DRM_V3D=m

# ---------------------------------------------------------------------------
# Remove unrelated high-cost graphics / accelerator drivers.
# Keep the DRM core and Raspberry Pi VC4/V3D paths above.
# ---------------------------------------------------------------------------
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_EXYNOS is not set
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_DRM_RCAR_DU is not set
# CONFIG_DRM_SUN4I is not set
# CONFIG_DRM_MSM is not set
# CONFIG_DRM_TEGRA is not set
# CONFIG_DRM_IMX is not set
# CONFIG_DRM_MXSFB is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_PANFROST is not set

# ---------------------------------------------------------------------------
# Remove unrelated storage / bus controller drivers.
# Keep SCSI and USB mass-storage infrastructure for USB disks.
# ---------------------------------------------------------------------------
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_SATA_AHCI is not set
# CONFIG_SATA_AHCI_PLATFORM is not set
# CONFIG_SATA_HIGHBANK is not set
# CONFIG_SATA_MV is not set
# CONFIG_SATA_RCAR is not set

# Disable non-Raspberry-Pi PCI host / endpoint implementations, not PCI core.
# CONFIG_PCI_MVEBU is not set
# CONFIG_PCI_TEGRA is not set
# CONFIG_PCI_RCAR_GEN2 is not set
# CONFIG_PCIE_RCAR_HOST is not set
# CONFIG_PCI_DRA7XX_EP is not set

# No virtual machine / virtio transport is required on the physical RPi2B.
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_MMIO is not set

# ---------------------------------------------------------------------------
# Non-target SoC Ethernet MACs. Keep generic networking and the Pi USB NIC.
# ---------------------------------------------------------------------------
# CONFIG_BCMGENET is not set
# CONFIG_NET_CALXEDA_XGMAC is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_STMMAC_PLATFORM is not set

# ---------------------------------------------------------------------------
# Non-target SoC audio machine drivers. USB audio remains enabled above.
# ---------------------------------------------------------------------------
# CONFIG_SND_SUN4I_CODEC is not set
# CONFIG_SND_SUN4I_I2S is not set
# CONFIG_SND_SUN4I_SPDIF is not set
# CONFIG_SND_SOC_FSL_ASRC is not set
# CONFIG_SND_SOC_FSL_SAI is not set
# CONFIG_SND_SOC_FSL_AUDMIX is not set
# CONFIG_SND_SOC_FSL_SSI is not set
# CONFIG_SND_SOC_FSL_SPDIF is not set
# CONFIG_SND_SOC_FSL_ESAI is not set
# CONFIG_SND_SOC_FSL_MICFIL is not set
# CONFIG_SND_SOC_XILINX_I2S is not set
# CONFIG_SND_SOC_XILINX_SPDIF is not set
