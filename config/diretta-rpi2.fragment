# Diretta ABI compatibility overlay for Raspberry Pi 2 Model B (bcm2709_defconfig)
# The official repository bcm2709_defconfig remains the sole base configuration.

CONFIG_LOCALVERSION="-215.fc36.armv7hl"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_SMP=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_RT is not set

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set

# Provide the page_address() implementation/export required by alsa_bridge.
# ARM exposes this through the HIGHMEM page-address mapping implementation.
CONFIG_HIGHMEM=y

# Keep the ARMv7 hardened usercopy / fortify implementation available.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Retain DWARF4 type information so the strict verifier can compare the
# original modules' this_module section size with this build's struct module.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set

# Do not require signed out-of-tree Diretta modules.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
