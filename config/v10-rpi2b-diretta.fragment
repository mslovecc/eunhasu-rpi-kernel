# One-time V10 rebuild trigger; no configuration change.
# V10: Raspberry Pi upstream rpi-6.2.y (Linux 6.2.16) + original Diretta ABI.
# Hardware base is generated by: make ARCH=arm bcm2709_defconfig
# Kernel release is intentionally spoofed to match the supplied original KO vermagic.

CONFIG_LOCALVERSION="-215.fc36.armv7hl"
# CONFIG_LOCALVERSION_AUTO is not set

# Exact vermagic requirements of alsa_bridge.ko and diretta_direct.ko.
CONFIG_SMP=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set

# No forced module-signature policy.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# ARMv7 EABI / p2v8 module architecture.
CONFIG_CPU_V7=y
CONFIG_AEABI=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
# CONFIG_THUMB2_KERNEL is not set
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y

# Required symbol providers / original kernel ABI features.
CONFIG_HIGHMEM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Fedora 36 ext4 SD root: these must be built in, not modules.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y

# Raspberry Pi 2B USB host, LAN9514 Ethernet and USB audio.
CONFIG_USB=y
CONFIG_USB_DWC2=m
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_STORAGE=m

# ALSA support used by the Diretta audio bridge.
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_TIMER=m
CONFIG_SND_SOC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_BCM2835=m

# Serial console.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
